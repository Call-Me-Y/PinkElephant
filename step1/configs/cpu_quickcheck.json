{
  "experiment_id": "cpu-quickcheck-v1",
  "mode": "controlled",
  "dataset": {
    "path": "data/smoke.jsonl", "split": "smoke", "world_seed": 20261112,
    "families": ["missing_argument", "unexpected_argument", "format_error"],
    "per_family": 2, "history_depths": [1, 2], "candidate_tasks": 120
  },
  "conditions": ["verbatim", "abstract", "positive_current", "positive_history", "verbatim_positive"],
  "backend": {
    "kind": "transformers", "model_path": "Qwen2.5-0.5B-Instruct", "device": "cpu",
    "cpu_threads": 4, "temperature": 0, "max_new_tokens": 96, "context_limit": 8192
  },
  "seed": 42, "samples": 1, "max_steps": 1, "max_requests": 10,
  "output_dir": "results/cpu-quickcheck-v1"
}
